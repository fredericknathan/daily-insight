<!--
High-Signal Daily Macro Brief Template
-->
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Daily Macro Brief</title>
<style>
  body { margin:0; padding:0; background-color:#ffffff; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: #111827; }
  .container { max-width:650px; margin:0 auto; background:#ffffff; padding: 20px; }
  
  h2 { font-size: 16px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #111827; padding-bottom: 4px; margin-top: 32px; margin-bottom: 16px; }
  
  /* Executive Summary */
  .exec-summary ul { padding-left: 20px; margin: 0 0 24px 0; }
  .exec-summary li { margin-bottom: 8px; font-size: 14px; line-height: 1.5; }
  
  /* Table */
  table.snapshot { width: 100%; border-collapse: collapse; margin-bottom: 32px; font-size: 13px; }
  table.snapshot th { text-align: left; border-bottom: 1px solid #d1d5db; padding: 8px 4px; color: #6b7280; font-weight: 600; text-transform: uppercase; font-size: 11px; }
  table.snapshot td { padding: 8px 4px; border-bottom: 1px solid #e5e7eb; }
  .up { color: #089981; font-weight: 600; }
  .down { color: #f23645; font-weight: 600; }
  .neutral { color: #6b7280; font-weight: 600; }
  
  /* Regional Themes */
  .region-block { margin-bottom: 24px; }
  .region-header { font-size: 14px; font-weight: 700; margin-bottom: 8px; color: #111827; }
  .region-list { padding-left: 20px; margin: 0; font-size: 13px; line-height: 1.5; }
  .region-list li { margin-bottom: 6px; }
  .mover { font-weight: 600; }
  
  /* Heatmap */
  .heatmap-wrapper { margin-top: 32px; text-align: center; }
  .heatmap-wrapper img { max-width: 100%; height: auto; border: 1px solid #e5e7eb; }
</style>
</head>
<body>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
<tr><td>
<div class="container">

  <p style="font-size:12px; color:#6b7280; margin-bottom:8px;">{{ date }}</p>
  {% if exec_summary.regime %}
  <p style="font-size:14px; font-weight:bold; color:#111827; margin-bottom:24px; font-style:italic;">"{{ exec_summary.regime }}"</p>
  {% endif %}

  <h2>1. Executive Summary</h2>
  <div class="exec-summary">
    <ul>
      <li><strong>Global Regime:</strong> {{ exec_summary.bullet_1_global_regime }}</li>
      <li><strong>Cross-Asset Transmission:</strong> {{ exec_summary.bullet_2_cross_asset }}</li>
      <li><strong>Catalysts:</strong> {{ exec_summary.bullet_3_catalysts }}</li>
    </ul>
  </div>

  <h2>2. Global Equities Heatmap</h2>
  <div class="heatmap-wrapper">
    <img src="cid:heatmap" alt="Global Equities Heatmap">
  </div>

  <h2>3. Sovereign Rates & FX Transmission</h2>
  <table class="snapshot">
    <thead>
      <tr>
        <th>Country</th>
        <th>10Y Sovereign Yield</th>
        <th>1D Δ</th>
        <th>Currency Pair</th>
        <th>FX Spot</th>
        <th>1D %</th>
      </tr>
    </thead>
    <tbody>
      {% for c in countries %}
      <tr>
        <td><strong>{{ c.name }}</strong></td>
        <td>{{ "%.2f"|format(c.rate_10y_pct) + "%" if c.rate_10y_pct is not none else "-" }}</td>
        <td>
          {% if c.rate_10y_bps_change is not none %}
            {% if c.rate_10y_bps_change > 0 %}<span class="up">+{{ "%.0f"|format(c.rate_10y_bps_change) }} bps</span>
            {% elif c.rate_10y_bps_change < 0 %}<span class="down">{{ "%.0f"|format(c.rate_10y_bps_change) }} bps</span>
            {% else %}<span class="neutral">0 bps</span>{% endif %}
          {% else %}-{% endif %}
        </td>
        <td><strong>{{ c.currency }}</strong></td>
        <td>{{ "{:,.4f}".format(c.fx_price) if c.fx_price is not none else "-" }}</td>
        <td>
          {% if c.fx_change_pct is not none %}
            {% if c.fx_change_pct > 0 %}<span class="up">+{{ "%.2f"|format(c.fx_change_pct) }}%</span>
            {% elif c.fx_change_pct < 0 %}<span class="down">{{ "%.2f"|format(c.fx_change_pct) }}%</span>
            {% else %}<span class="neutral">0.00%</span>{% endif %}
          {% else %}-{% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>4. Regional Breakdown</h2>
  {% for c in countries %}
  {% if c.macro_driver or c.sector_driver %}
  <div class="region-block">
    <div class="region-header">{{ c.name }} | {{ c.index_name }} ({{ c.ticker }}): {{ "{:,.2f}".format(c.price) if c.price is not none else "-" }} ({% if c.change_pct is not none %}{{ "%+.2f"|format(c.change_pct) }}%{% else %}-{% endif %})</div>
    <ul class="region-list">
      {% if c.macro_driver %}<li><strong>Macro & Liquidity:</strong> {{ c.macro_driver }}</li>{% endif %}
      {% if c.sector_driver %}<li><strong>Sector Dynamics:</strong> {{ c.sector_driver }}</li>{% endif %}
      {% if c.key_movers and c.key_movers | length > 0 %}
        <li><strong>Key Drivers:</strong>
          {% for m in c.key_movers %}
            <br>&nbsp;&nbsp;• <strong>{{ m.company }}{% if m.ticker %} ({{ m.ticker }}){% endif %}</strong>{% if m.delta %}: {{ m.delta }}{% endif %} - {{ m.context }}
          {% endfor %}
        </li>
      {% endif %}
    </ul>
  </div>
  {% endif %}
  {% endfor %}

</div>
</td></tr>
</table>
</body>
</html>
