# Copy to .env for local runs. In GitHub Actions, set these as repo
# Settings > Secrets and variables > Actions > New repository secret.
# GITHUB_TOKEN does NOT go here — Actions injects it automatically.

# Gmail app password — generate at myaccount.google.com/apppasswords
# (requires 2FA enabled on the account first)
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where the brief gets sent — can be the same as GMAIL_ADDRESS
BRIEF_RECIPIENT=your.email@gmail.com

# FRED API key — free, register at fred.stlouisfed.org, no card needed
FRED_API_KEY=

# For local testing of the GitHub Models client only — in CI this is
# GITHUB_TOKEN, injected automatically. Locally, use a fine-grained PAT
# with the "Models" > read permission.
GITHUB_TOKEN=
